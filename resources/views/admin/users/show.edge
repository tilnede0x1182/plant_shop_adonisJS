@section('content')
<div class="container mt-4">
	<h1>Détail utilisateur</h1>
	<p>
		@if(utilisateur.name)
		<strong>Nom :</strong> {{ utilisateur.name }}<br>
		@endif
		<strong>Email :</strong> {{ utilisateur.email }}
	</p>

	<div class="d-inline-flex align-items-stretch">
		<a href="{{ route('admin.users.edit', { id: utilisateur.id }) }}" class="btn btn-warning px-4">
			Modifier
		</a>

		<form method="POST"
			action="{{ route('admin.users.destroy', { id: utilisateur.id }, { qs: { _method: 'DELETE' } }) }}"
			onsubmit="return confirm('Voulez-vous supprimer cet utilisateur ?')" class="ms-2">
			{{ csrfField() }}
			<button type="submit" class="btn btn-danger px-4">
				🗑 Supprimer
			</button>
		</form>
	</div>
</div>
